# @BotFather bergan token
TELEGRAM_BOT_TOKEN=123456789:AA...

# Qaysi AI ishlaydi: claude (standart), gemini yoki openai
# Eslatma: quyidagi nomlar topilmasa, kod AI_API_KEY ga qaraydi —
# ya'ni bitta AI_API_KEY yozib qo'yish ham yetarli.
AI_PROVIDER=gemini

# Gemini kaliti — https://aistudio.google.com/apikey (bepul limiti bor)
GEMINI_API_KEY=AQ...

# Anthropic kaliti — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI kaliti — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Ixtiyoriy: webhook'ni begona so'rovlardan himoyalash uchun o'zingiz o'ylab topgan satr.
# setWebhook chaqiruvida ham xuddi shu qiymatni bering. Bo'sh qoldirsangiz tekshiruv o'chadi.
TELEGRAM_WEBHOOK_SECRET=
