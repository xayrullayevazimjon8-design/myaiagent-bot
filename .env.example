# @BotFather bergan token
TELEGRAM_BOT_TOKEN=123456789:AA...

# Qaysi AI ishlaydi: claude (standart), gemini yoki openai
# Eslatma: quyidagi nomlar topilmasa, kod AI_API_KEY ga qaraydi —
# ya'ni bitta AI_API_KEY yozib qo'yish ham yetarli.
AI_PROVIDER=gemini

# Gemini kaliti — https://aistudio.google.com/apikey (bepul limiti bor)
GEMINI_API_KEY=AQ...

# Anthropic kaliti — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI kaliti — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Suhbat xotirasi: bot oxirgi 10 juftlik (savol + javob) ni eslab qoladi.
# Quyidagi ikkitasi bo'lmasa xotira funksiyaning o'z xotirasida turadi — sinov
# uchun yetarli, lekin Vercel funksiya nusxasini o'chirganda yo'qoladi.
# Ishonchli saqlash uchun Upstash Redis (yoki Vercel KV) ulang:
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Xotirani butunlay o'chirish: XOTIRA=off
XOTIRA=

# Qidiruv vositasi — internet manbasi. https://tavily.com (bepul tarifi bor).
# Bo'sh qoldirilsa vosita faqat bilim/ papkasidan qidiradi, xato bermaydi.
TAVILY_API_KEY=tvly-...

# Vositalarni butunlay o'chirish: VOSITA=off
VOSITA=

# Kover rasm — alohida kalit kerak bo'lsa. Bo'sh bo'lsa GEMINI_API_KEY ishlatiladi.
# Umuman kalit bo'lmasa kover shablon ko'rinishida yasaladi, xato bermaydi.
RASM_API_KEY=
# Rasm modeli (ixtiyoriy). Standart: gemini-3.1-flash-image
RASM_MODEL=

# Koverni butunlay o'chirish: KOVER=off
KOVER=

# Ixtiyoriy: webhook'ni begona so'rovlardan himoyalash uchun o'zingiz o'ylab topgan satr.
# setWebhook chaqiruvida ham xuddi shu qiymatni bering. Bo'sh qoldirsangiz tekshiruv o'chadi.
TELEGRAM_WEBHOOK_SECRET=
